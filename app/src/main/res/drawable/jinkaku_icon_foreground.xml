<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="7dp" android:top="7dp" android:right="7dp" android:bottom="7dp">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:angle="270"
                android:startColor="#101A3D"
                android:centerColor="#08132F"
                android:endColor="#120C2B" />
        </shape>
    </item>

    <item android:left="18dp" android:top="18dp" android:right="18dp" android:bottom="18dp">
        <shape android:shape="oval">
            <solid android:color="#00000000" />
            <stroke android:width="1.6dp" android:color="#BFD9F4FF" />
        </shape>
    </item>

    <item
        android:width="82dp"
        android:height="13dp"
        android:gravity="center">
        <bitmap
            android:src="@drawable/jinkaku_wordmark_png"
            android:gravity="fill" />
    </item>
</layer-list>
